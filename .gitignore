# Datasets are reproducible from datagen/ (commands in the README) and are about 800 MB per
# family, so only the manifests are versioned. They record the seeds, ranges and library
# versions that produced each family.
/data/**/*.parquet
/data/dev/

# The metrics of every run the thesis reports are versioned under results/, and so are the
# checkpoints of the two models the thesis is about. The other 24 checkpoints ship as a
# release asset (checkpoints_best.zip); per-run figures and the per-voxel ND dumps (about
# 14 MB per run) are regenerated by the scripts.
/results/*/checkpoints/*
!/results/loss_uniform/checkpoints/best.pt
!/results/baseline_v2_reproduction/checkpoints/best.pt
/results/**/figures/
/checkpoints_best.zip
/results/nd_evaluation/*.json
!/results/nd_evaluation/paired_deltas.json
!/results/nd_evaluation/tables_2d_3d.json
/results/_scratch/
/results/smoke/

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.DS_Store
.ipynb_checkpoints/

# inference cache of the thesis notebook
/notebooks/.cache_visuals/
